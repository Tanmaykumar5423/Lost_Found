# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clfis_db

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
QR_TOKEN_EXPIRE_MINUTES=15

# Campus Email Validation
CAMPUS_EMAIL_DOMAIN=college.edu

# File Upload Target
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE=10485760

# ML Models
SIGLIP_MODEL=google/siglip-base-patch16-224

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
